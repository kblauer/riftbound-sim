# Copy to .env.local (git-ignored). All three are optional for local play against the AI:
# without them, sign-in and online play are disabled and the board uses placeholder cards.

# Supabase project URL and publishable (anon) key. Safe to expose to the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# The match server (apps/server). `pnpm dev` runs it on port 8787.
VITE_SERVER_URL=http://localhost:8787
