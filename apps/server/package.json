{
  "name": "@riftbound-sim/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "typecheck": "wrangler types --strict-vars=false && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@riftbound-sim/db": "workspace:*",
    "@riftbound-sim/engine": "workspace:*",
    "@riftbound-sim/protocol": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.20",
    "jose": "^6.2.18",
    "partyserver": "^0.5.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
