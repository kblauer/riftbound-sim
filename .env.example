# Root .env (git-ignored): used by the card seed script (`pnpm db:seed`).
# The web app and match server have their own files:
#   apps/web/.env.example       -> apps/web/.env.local
#   apps/server/.dev.vars.example -> apps/server/.dev.vars
#   Google OAuth for local Supabase -> supabase/.env (see README)

SUPABASE_URL=http://127.0.0.1:54321
# Service-role (secret) key. Bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Sent to RiftHunt so they can identify this project (their API docs ask for it).
RIFTHUNT_USER_AGENT=riftbound-sim (private test project)
